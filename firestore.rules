rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Approved admin or super admin. Missing status stays approved (see isApproved).
    // The first super admin must be set in the Firebase console before these rules
    // are deployed. The client cannot grant that first role.
    function isAdmin() {
      return isSignedIn() && isApproved() && (
        currentUserDoc().data.get('role', null) == 'admin' ||
        currentUserDoc().data.get('role', null) == 'superadmin'
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && isApproved() &&
        currentUserDoc().data.get('role', null) == 'superadmin';
    }

    // Missing status is treated as approved for backward compatibility.
    function isApproved() {
      return isSignedIn() && (
        !('status' in currentUserDoc().data) ||
        currentUserDoc().data.status == 'approved'
      );
    }

    // Missing role is treated as tester when an admin edits someone else's doc.
    function roleOf(data) {
      return data.get('role', 'tester');
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if
        (isOwner(userId)
          && request.resource.data.role == 'tester'
          && request.resource.data.status == 'pending')
        || (isSuperAdmin() && (
          request.auth.uid != userId ||
          request.resource.data.role == 'superadmin'
        ))
        || (isAdmin() && !isSuperAdmin()
          && request.auth.uid != userId
          && request.resource.data.role == 'tester');
      // Owners cannot change role, status, approvedBy, or approvedAt.
      // .get(..., null) keeps a missing field from failing the whole rule.
      // A super admin cannot demote or delete themselves, so the last super admin
      // cannot be removed from the client. Another super admin can change them.
      // Regular admins may update or delete tester docs only, and cannot set
      // role to admin or superadmin.
      allow update: if
        (isOwner(userId)
          && request.resource.data.get('role', null) == resource.data.get('role', null)
          && request.resource.data.get('status', null) == resource.data.get('status', null)
          && request.resource.data.get('approvedBy', null) == resource.data.get('approvedBy', null)
          && request.resource.data.get('approvedAt', null) == resource.data.get('approvedAt', null))
        || (isSuperAdmin() && request.auth.uid != userId)
        || (isAdmin() && !isSuperAdmin()
          && roleOf(resource.data) == 'tester'
          && roleOf(request.resource.data) == 'tester');
      allow delete: if
        (isSuperAdmin() && request.auth.uid != userId)
        || (isAdmin() && !isSuperAdmin() && roleOf(resource.data) == 'tester');

      match /solutionProfiles/{profileId} {
        allow read, write: if isOwner(userId) && isApproved();
      }

      match /schoolProfiles/{profileId} {
        allow read, write: if isOwner(userId) && isApproved();
      }
    }

    match /fitTests/{fitTestId} {
      allow read: if
        isSignedIn() &&
        isApproved() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow update, delete: if
        isSignedIn() &&
        isApproved() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if
        isSignedIn() &&
        isApproved() &&
        request.auth.uid == request.resource.data.userId;
    }

    // Public resend: guests can get a lookup doc only if they know the name+DOB hash.
    // Listing is denied so the collection cannot be dumped.
    match /fitTestLookups/{lookupKey} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isSignedIn() && isApproved();
      allow delete: if
        isSignedIn() &&
        isApproved() &&
        (isAdmin() || request.auth.uid == resource.data.userId);
    }

    // Public verify: guests can read one verification doc only if they know the token.
    // Listing is denied so the collection cannot be dumped.
    match /fitTestVerifications/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isSignedIn() && isApproved();
      allow delete: if
        isSignedIn() &&
        isApproved() &&
        (isAdmin() || request.auth.uid == resource.data.userId);
    }

    // One log per signed-in staff uid. Used to cap the two test accounts at 1 send / 24h.
    match /emailSendLog/{userId} {
      allow get: if isOwner(userId) && isApproved();
      allow list: if false;
      allow create, update: if isOwner(userId) && isApproved();
      allow delete: if false;
    }
  }
}
