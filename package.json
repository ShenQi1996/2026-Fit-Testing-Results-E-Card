{
  "name": "email-form-app",
  "version": "1.1.0",
  "description": "Secure Fit LLC qualitative fit-test e-card app for testers and public verify/resend",
  "main": "index.js",
  "scripts": {
    "start": "webpack serve --mode=development",
    "build": "webpack --mode=production",
    "build:dev": "webpack --mode=development",
    "lint": "eslint src",
    "test": "jest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-fit-test-rules \"jest --config jest.rules.config.js --forceExit\"",
    "backfill:schools": "node scripts/backfill-schools.js",
    "backfill:user-status": "node scripts/backfillUserStatus.js",
    "seed:staging": "node scripts/seed-staging.js"
  },
  "keywords": [
    "fit-test",
    "respirator",
    "e-card",
    "firebase",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "firebase": "^10.7.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lottie-react": "^3.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-react": "^7.23.3",
    "@firebase/rules-unit-testing": "^3.0.4",
    "babel-jest": "^30.5.2",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.8.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^30.5.2",
    "mini-css-extract-plugin": "^2.7.6",
    "react-test-renderer": "^18.3.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
