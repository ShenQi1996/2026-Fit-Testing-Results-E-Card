# Copy to .env.local. Do not commit .env.local.
# Leave APP_ENV unset to use the built-in production project fit-test-result-e-card-2026.
# Set APP_ENV=staging only for the staging project. That build fails if any FIREBASE_* value is empty.
# FIREBASE_API_KEY is the web app API key. Set it in Vercel (Preview, branch staging) and in .env.local.
# Do not put that key in git.
#
# Preview for Git branch staging (project fit-test-result-e-card-staging):
#   APP_ENV=staging
#   FIREBASE_AUTH_DOMAIN=fit-test-result-e-card-staging.firebaseapp.com
#   FIREBASE_PROJECT_ID=fit-test-result-e-card-staging
#   FIREBASE_STORAGE_BUCKET=fit-test-result-e-card-staging.firebasestorage.app
#   FIREBASE_MESSAGING_SENDER_ID=966738964858
#   FIREBASE_APP_ID=1:966738964858:web:9a5324a2db3326169666c3
# Adding these on Vercel Production later is optional. See STAGING.md.

# APP_ENV=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Seed script only. Path to the staging service account JSON. Never commit that file.
# FIREBASE_SERVICE_ACCOUNT_PATH=
# STAGING_SEED_PASSWORD=
