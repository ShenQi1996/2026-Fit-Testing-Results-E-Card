# Copy to .env.local and fill in the web app config from the Firebase console.
# Production Vercel uses fit-test-result-e-card-2026.
# Preview builds for branch staging use fit-test-result-e-card-staging.
# The build fails if any of these are empty. Do not commit .env.local.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Seed script only. Path to the staging service account JSON. Never commit that file.
# FIREBASE_SERVICE_ACCOUNT_PATH=
# STAGING_SEED_PASSWORD=
