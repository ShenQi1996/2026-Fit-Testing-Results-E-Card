# Copy to .env.local for local development. Do not commit .env.local.
# webpack reads .env.local only when a variable is not already in the environment.
#
# `npm start` (NODE_ENV=development) always uses the staging project
# fit-test-result-e-card-staging. If any FIREBASE_* value is missing, or if one
# matches production, the dev server fails instead of using
# fit-test-result-e-card-2026. The staging API key is not committed; fill it in
# below. Production builds (`npm run build`, Vercel with APP_ENV unset) still
# use the built-in production Firebase config.

APP_ENV=staging
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=fit-test-result-e-card-staging.firebaseapp.com
FIREBASE_PROJECT_ID=fit-test-result-e-card-staging
FIREBASE_STORAGE_BUCKET=fit-test-result-e-card-staging.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=966738964858
FIREBASE_APP_ID=1:966738964858:web:9a5324a2db3326169666c3

# Seed script only. Path to the staging service account JSON. Never commit that file.
# GOOGLE_APPLICATION_CREDENTIALS=
# Password for --with-auth. Never commit it and never hardcode it.
# SEED_PASSWORD=
